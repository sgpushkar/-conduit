# Placeholders only. Never commit a real .env.
CORS_ORIGINS=http://localhost:5173
LLM_API_KEY=your-key-here
LLM_MODEL=your-model-id
LLM_API_URL=https://api.anthropic.com/v1/messages
SEMGREP_CONFIG=auto
ALLOW_DOCKER_TESTS=true
STEP_TIMEOUT_SECONDS=300
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:5173
ENV=dev
SESSION_TTL_SECONDS=28800
MAX_ATTEMPTS=2
# Queue mode: set BOTH DATABASE_URL and REDIS_URL, otherwise runs stay in memory.
# App traffic goes through PgBouncer (6432); migrations connect straight to Postgres (5432).
DATABASE_URL=postgresql+asyncpg://conduit:change-me@localhost:6432/conduit
MIGRATION_DATABASE_URL=postgresql+asyncpg://conduit:change-me@localhost:5432/conduit
REDIS_URL=redis://:change-me-too@localhost:6379/0
# generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-key-here
WORKER_CONCURRENCY=2
